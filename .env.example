# =============================================================================
# Environment Configuration - Simple Python Blog
# =============================================================================
# Copy this file to .env and fill in the values.
#
# Annotations:
# (required)    - must be set in the named environment
# (optional)    - has a sensible default; override if needed
# (conditional) - required only when a related feature is enabled
#
# Load: uv run --env-file .env manage.py runserver (or: export $(grep -v '^#' .env | xargs))
# =============================================================================

# -----------------------------------------------------------------------------
# Core
# -----------------------------------------------------------------------------
# (required)
# Which settings module to use:
# development: config.settings.development
# production: config.settings.production
# test: config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.development

# (required - prod, dev) (optional - test)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# (required - prod) (optional - dev)
# Use localhost,127.0.0.1 for local development; list production hosts in prod.
ALLOWED_HOSTS=localhost,127.0.0.1

# (optional) (DEBUG|INFO|WARNING|ERROR|CRITICAL, default dev=DEBUG/prod=INFO)
LOG_LEVEL=DEBUG

# (optional) SQLite file location (default: db.sqlite3 in project root)
DATABASE_PATH=db.sqlite3

# (optional) Days a soft-deleted post is kept before purge (default: 30)
POST_RETENTION_DAYS=30

# (optional) Collection page size (default: 20)
API_PAGE_SIZE=20
